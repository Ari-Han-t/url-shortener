# Database Secrets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=url_shortener
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Secrets
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secrets
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256

# Public origin used in MCP tool output (short_url), e.g. https://short.example.com
PUBLIC_BASE_URL=

# Offline IP geolocation database (run scripts/update_geoip.sh). Optional; location is empty without it.
GEOIP_DB_PATH=data/dbip-city-lite.mmdb
